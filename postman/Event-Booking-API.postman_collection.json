          "name": "01 Register User A",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r=Date.now().toString();",
                  "pm.environment.set(\"runId\",r);",
                  "pm.environment.set(\"userAUsername\",\"qa_user_a_\"+r);",
                  "pm.environment.set(\"userAEmail\",\"qa_user_a_\"+r+\"@example.test\");",
                  "pm.environment.set(\"userBUsername\",\"qa_user_b_\"+r);",
                  "pm.environment.set(\"userBEmail\",\"qa_user_b_\"+r+\"@example.test\");",
                  "pm.environment.set(\"futureStartTime\",new Date(Date.now()+7*24*60*60*1000).toISOString());",
                  "[\"userAToken\",\"userBToken\",\"organizerToken\",\"userAId\",\"userBId\",\"eventId\",\"bookingId\",\"userBBookingId\"].forEach(k=>pm.environment.unset(k));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\",function(){pm.response.to.have.status(201);});",
                  "const json=pm.response.json();",
                  "pm.test(\"Registered role is user\",()=>pm.expect(json.role).to.eql(\"user\"));",
                  "pm.test(\"Password is absent\",()=>pm.expect(json).not.to.have.property(\"password\"));",
                  "if(pm.response.code===201&&json.id)pm.environment.set(\"userAId\",String(json.id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"{{userAUsername}}\",\"email\":\"{{userAEmail}}\",\"password\":\"{{userPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
